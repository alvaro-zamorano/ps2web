+void CGSHandler::Ps2webCreateThreadOnMain(void* p)
+{
+	// Runs on the main thread. "#outputCanvas" is looked up in the DOM and transferred
+	// (transferControlToOffscreen) to the new pthread, which creates its WebGL context on it.
+	auto self = static_cast<CGSHandler*>(p);
+	pthread_attr_t attr;
+	pthread_attr_init(&attr);
+	emscripten_pthread_attr_settransferredcanvases(&attr, "#outputCanvas");
+	pthread_t t = 0;
+	int rc = pthread_create(&t, &attr, &CGSHandler::Ps2webThreadEntry, self);
+	pthread_attr_destroy(&attr);
+	assert(rc == 0);
