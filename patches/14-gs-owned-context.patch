+#if defined(__EMSCRIPTEN__)
+// PS2WEB(14): GS as an event-loop thread.
+//   Why: with -sOFFSCREEN_FRAMEBUFFER the WebGL context lived on the main thread and EVERY GL call
+//   from the GS pthread was proxied there (glTexImage2D/glTexSubImage2D >= 256KB, glGenTextures,
+//   glDeleteTextures, glReadPixels are SYNCHRONOUS round-trips; the rest allocate+post). The bisect
+//   in docs/PROFILE-DBZ.md §11 showed the GS thread ~90% busy even with zero draws — that was this.
+//   Now the GS pthread owns the OffscreenCanvas and calls WebGL directly. The catch: OffscreenCanvas
+//   only presents a frame when the worker returns to its JS event loop, so the blocking
+//   WaitForCall loop is replaced by: EE pushes -> Ps2webKick (at most one pending kick) ->
+//   Ps2webDrain runs as a task in the GS worker, processes messages until the queue is empty OR a
+//   flip happened (then yields so the browser can present), and re-schedules itself if needed.
+void* CGSHandler::Ps2webThreadEntry(void* p)
+{
+	auto self = static_cast<CGSHandler*>(p);
+	self->m_ps2webThreadStarted.store(true);
+	self->Ps2webDrain(); // anything queued before the (async) thread start
+	// Keep the worker alive in its JS event loop; work arrives via Ps2webDrainThunk. NOTE: plain
+	// emscripten_unwind_to_js_event_loop() is NOT enough for a pthread (its runtime-keepalive
+	// counter is 0 -> the thread exits right after unwinding); this one bumps the counter first.
+	emscripten_exit_with_live_runtime();
+	return nullptr;
+}
+
+void CGSHandler::Ps2webDrainThunk(void* p)
+{
+	static_cast<CGSHandler*>(p)->Ps2webDrain();
+}
+
+void CGSHandler::Ps2webDrain()
+{
+	auto _ps2webGsB0 = std::chrono::steady_clock::now();
+	m_flipped = false;
+	while(m_mailBox.IsPending())
+	{
+		m_mailBox.ReceiveCall();
+		if(m_flipped) break; // yield: let the browser present this frame
+	}
+	g_ps2webGsBusyNs += std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - _ps2webGsB0).count();
+	m_ps2webKickPending.store(false);
+	if(m_threadDone)
+	{
+		pthread_exit(nullptr);
+	}
+	if(m_mailBox.IsPending())
+	{
+		// More work already queued: continue on the next event-loop turn. Self-proxy through the
+		// mailbox (Atomics.waitAsync-notified): emscripten_set_immediate() is NOT usable here, its
+		// worker polyfill does postMessage(id, "*") which throws in a DedicatedWorkerGlobalScope,
+		// and emscripten_set_timeout(0) hits the browser's 4ms nested-timer clamp.
+		if(!m_ps2webKickPending.exchange(true))
+		{
+			emscripten_proxy_async(emscripten_proxy_get_system_queue(), pthread_self(), &CGSHandler::Ps2webDrainThunk, this);
+		}
+	}
+}
+
+void CGSHandler::Ps2webKick()
+{
+	// Called on the SENDER thread after a push. One outstanding kick is enough: the drain re-checks
+	// the queue after clearing the flag, so a push that lands during a drain is never lost.
+	if(m_ps2webKickPending.exchange(true)) return;
+	if(!m_ps2webThreadStarted.load())
+	{
+		// Thread not running yet: its entry drains the queue on start. Leave the flag set so we
+		// don't spam proxied calls at a mailbox that isn't being serviced; the entry drain clears it.
+		return;
+	}
+	emscripten_proxy_async(emscripten_proxy_get_system_queue(), m_ps2webGsThread, &CGSHandler::Ps2webDrainThunk, this);
+}
+#endif
