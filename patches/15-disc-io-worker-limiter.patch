+{
+	CTRL_STATE = 0,
+	CTRL_OFF_LO = 1,
+	CTRL_OFF_HI = 2,
+	CTRL_SIZE = 3,
+	CTRL_DST = 4,
+	CTRL_RESULT = 5,
+	CTRL_FSIZE_LO = 6,
+	CTRL_FSIZE_HI = 7,
