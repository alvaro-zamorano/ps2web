+	uint32 hi = static_cast<uint32>(m_ctrl[CTRL_FSIZE_HI]);
+	m_fileSize = static_cast<uint64>(lo) | (static_cast<uint64>(hi) << 32);
+	m_cache.resize(PS2WEB_DISC_CHUNK);
+	printf("PS2WEB(15): disc reads via IO worker (ctrl=%d, size=%llu, chunk=%u)\r\n", ptr, (unsigned long long)m_fileSize, (unsigned)PS2WEB_DISC_CHUNK);
