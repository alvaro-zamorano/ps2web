+	if(m_ctrlResolved) return m_ctrl != nullptr;
+	m_ctrlResolved = true;
+	// One proxied call per boot (main is idle while the EE boots a disc).
+	int32_t ptr = MAIN_THREAD_EM_ASM_INT({
+		try
+		{
+			var d = Module.discImageDevice;
+			return (d && typeof d.getCtrlPtr === 'function') ? (d.getCtrlPtr() | 0) : 0;
+		}
+		catch(e)
