@@ -61,6 +61,13 @@ extern std::atomic<uint64_t> g_ps2webIopExecNs; // PS2WEB(15), BasicBlock.cpp
 static std::atomic<int> g_ps2webVmReady{0};
 static std::atomic<uint32_t> g_ps2webVblanks{0}; // PS2WEB(15)
 CPS2VM::NewFrameEvent::Connection g_ps2webVblankConnection;
